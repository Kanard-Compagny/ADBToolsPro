<Window x:Class="ADBToolsNew.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADB Tools Pro" Height="430" Width="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        FontFamily="{DynamicResource FontUi}" Icon="app_icon.ico">

    <Window.Resources>
        <!-- Boutons du premier lancement (fenêtre de démarrage sur fond vert) -->
        <Style x:Key="SplashPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Action}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAction}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActionHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SplashSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SideInk}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SideMuted}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Choix du premier lancement (langue, taille, thème) -->
        <Style x:Key="SplashPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SideInk}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource SideHoverBg}" BorderBrush="{DynamicResource SideActiveBg}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SideMuted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Action}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Action}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Action}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnAction}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
    <!-- Ombre portée discrète (comme la fenêtre principale), sur un calque à part pour ne pas flouter le contenu. -->
    <Border CornerRadius="12" Background="{DynamicResource SideBg}">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="3" BlurRadius="18" Opacity="0.45" Color="Black"/>
        </Border.Effect>
    </Border>
    <!-- Liseré fin vert pour délimiter la fenêtre. -->
    <Border Background="{DynamicResource SideBg}" CornerRadius="12" BorderBrush="{DynamicResource SideActiveBg}" BorderThickness="1" Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Démarrage normal -->
            <StackPanel x:Name="StartupPanel" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Resources/splash_adbtools.png" Width="380" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="ADB Tools Pro"/>
                <TextBlock x:Name="TxtVersion" Text="version" FontSize="14" Foreground="{DynamicResource SideMuted}" HorizontalAlignment="Center" Margin="0,12,0,20"/>

                <ProgressBar x:Name="ProgBar" Height="4" Width="320" IsIndeterminate="True" Foreground="{DynamicResource Action}" Background="{DynamicResource SideHoverBg}" BorderThickness="0" Margin="0,0,0,12"/>

                <TextBlock x:Name="TxtStatus" Text="Initialisation des composants..." FontSize="12" Foreground="{DynamicResource SideInk}" HorizontalAlignment="Center" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440"/>
            </StackPanel>

            <!-- Premier lancement : langue, taille de l'interface, thème (textes posés par le code, dans la langue choisie) -->
            <StackPanel x:Name="SetupPanel" Grid.Row="0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TxtSetupTitle" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SideInk}" FontFamily="{DynamicResource FontDisplay}"/>
                <TextBlock x:Name="TxtSetupIntro" FontSize="12.5" Foreground="{DynamicResource SideMuted}" TextWrapping="Wrap" Margin="0,4,0,18"/>

                <TextBlock x:Name="TxtSetupLang" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SideInk}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="SetupLangChoices" Margin="0,0,0,10">
                    <RadioButton GroupName="SetupLang" Tag="fr" Content="Français" Style="{StaticResource SplashPill}" Checked="SetupLang_Checked"/>
                    <RadioButton GroupName="SetupLang" Tag="en" Content="English" Style="{StaticResource SplashPill}" Checked="SetupLang_Checked"/>
                </WrapPanel>

                <TextBlock x:Name="TxtSetupSize" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SideInk}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel x:Name="SetupScaleChoices">
                            <RadioButton GroupName="SetupScale" Tag="0.8" Content="80 %" Style="{StaticResource SplashPill}" Checked="SetupScale_Checked"/>
                            <RadioButton GroupName="SetupScale" Tag="0.9" Content="90 %" Style="{StaticResource SplashPill}" Checked="SetupScale_Checked"/>
                            <RadioButton GroupName="SetupScale" Tag="1" Content="100 %" Style="{StaticResource SplashPill}" Checked="SetupScale_Checked"/>
                            <RadioButton GroupName="SetupScale" Tag="1.15" Content="115 %" Style="{StaticResource SplashPill}" Checked="SetupScale_Checked"/>
                            <RadioButton GroupName="SetupScale" Tag="1.3" Content="130 %" Style="{StaticResource SplashPill}" Checked="SetupScale_Checked"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtSetupScreen" FontSize="12" Foreground="{DynamicResource SideMuted}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        <TextBlock x:Name="TxtSetupFit" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <!-- Aperçu : l'écran, et la place que prend l'interface à la taille choisie -->
                    <Border x:Name="SetupScreenBox" Grid.Column="1" Width="150" Height="90" Margin="16,0,0,0" VerticalAlignment="Top"
                            BorderBrush="{DynamicResource SideMuted}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource SideHoverBg}">
                        <Border x:Name="SetupAppBox" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="2" BorderThickness="1.5"
                                Background="{DynamicResource SideActiveBg}" BorderBrush="{DynamicResource BrandText}"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="TxtSetupTheme" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SideInk}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="SetupThemeChoices" Margin="0,0,0,14">
                    <RadioButton GroupName="SetupTheme" Tag="System" Style="{StaticResource SplashPill}" Checked="SetupTheme_Checked"/>
                    <RadioButton GroupName="SetupTheme" Tag="Light" Style="{StaticResource SplashPill}" Checked="SetupTheme_Checked"/>
                    <RadioButton GroupName="SetupTheme" Tag="Dark" Style="{StaticResource SplashPill}" Checked="SetupTheme_Checked"/>
                </WrapPanel>

                <Grid>
                    <TextBlock x:Name="TxtSetupNote" FontSize="11.5" Foreground="{DynamicResource SideMuted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,140,0"/>
                    <Button x:Name="BtnSetupContinue" Style="{StaticResource SplashPrimaryButton}" HorizontalAlignment="Right" Click="BtnSetupContinue_Click"/>
                </Grid>
            </StackPanel>

            <!-- Question / message (premier lancement, erreur de téléchargement) dans la même fenêtre -->
            <StackPanel x:Name="MessagePanel" Grid.Row="0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TxtMessageTitle" Text="" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource SideInk}" FontFamily="{DynamicResource FontDisplay}" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtMessageBody" Text="" FontSize="13" Foreground="{DynamicResource SideInk}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,8"/>
                <StackPanel x:Name="MessageItems" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtMessageNote" Text="" FontSize="12" Foreground="{DynamicResource SideMuted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMessageSecondary" Content="Plus tard" Style="{StaticResource SplashSecondaryButton}" Margin="0,0,10,0" Click="BtnMessageSecondary_Click"/>
                    <Button x:Name="BtnMessagePrimary" Content="Télécharger" Style="{StaticResource SplashPrimaryButton}" Click="BtnMessagePrimary_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>

                                <StackPanel x:Name="SettingsPanelAbout" Visibility="Collapsed">
                                    <TextBlock Text="À propos" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource FontDisplay}"/>

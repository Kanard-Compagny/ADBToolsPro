                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Content="−" Click="BtnBrightnessMinus_Click" Style="{StaticResource SidebarToggleStyle}" Width="28" Height="28" FontSize="16" Margin="0,0,4,0"/>
                                                            <TextBox x:Name="TxtBrightness" Grid.Column="1" Height="28" VerticalContentAlignment="Center" TextAlignment="Center" ToolTip="De 0 à 100% — Entrée pour valider" KeyDown="TxtBrightness_KeyDown"/>
                                                            <Button Content="+" Click="BtnBrightnessPlus_Click" Style="{StaticResource SidebarToggleStyle}" Width="28" Height="28" FontSize="16" Grid.Column="2" Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Densité (DPI)" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Content="−" Click="BtnDpiMinus_Click" Style="{StaticResource SidebarToggleStyle}" Width="28" Height="28" FontSize="16" Margin="0,0,4,0"/>
                                                            <TextBox x:Name="TxtDpiValue" Grid.Column="1" Height="28" VerticalContentAlignment="Center" TextAlignment="Center" ToolTip="Entrée pour valider" KeyDown="TxtDpiValue_KeyDown"/>
                                                            <Button Content="+" Click="BtnDpiPlus_Click" Style="{StaticResource SidebarToggleStyle}" Width="28" Height="28" FontSize="16" Grid.Column="2" Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Résolution" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="5"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="TxtResValue" Text="" Height="28" VerticalContentAlignment="Center" ToolTip="Ex: 720x1280"/>
                                                            <Button Content="Valider" Click="BtnSetRes_Click" Style="{StaticResource OutlineButtonStyle}" Grid.Column="2" Padding="8,0"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <Button Content="🔄 Réinitialiser l'affichage (DPI &amp; Résolution par défaut)" Click="BtnResetDisplay_Click" Style="{StaticResource OutlineButtonStyle}" Height="30" Margin="0,0,0,15"/>

                                                <TextBlock Text="Mise en veille :" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="CmbScreenTimeout" Height="28">
                                                        <ComboBoxItem Content="30 secondes"/>
                                                        <ComboBoxItem Content="1 minute"/>
                                                        <ComboBoxItem Content="5 minutes"/>
                                                        <ComboBoxItem Content="30 minutes"/>
                                                        <ComboBoxItem Content="Jamais (Écran toujours allumé)" IsSelected="True"/>
                                                    </ComboBox>
                                                    <Button Content="Appliquer" Click="BtnSetTimeout_Click" Style="{StaticResource OutlineButtonStyle}" Grid.Column="2"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">

                                        <TextBlock Text="Mise à jour OS" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,15"/>
                                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource DangerRedColor}" ShadowDepth="0" BlurRadius="22" Opacity="0.9"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="📦 Flasher une mise à jour OS (.zip)" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                <TextBlock Text="Si vous flashez via USB, assurez-vous qu'un SEUL terminal est branché au PC. Redémarrez d'abord en Recovery." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="1. Reboot Recovery" Click="BtnRecovery_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" ToolTip="Redémarre le terminal dans le menu Recovery"/>
                                                    <Button x:Name="BtnSideloadOs" Content="2. Flasher l'OS (.zip)" Click="BtnSideloadOs_Click" Style="{StaticResource DangerButtonStyle}" Grid.Column="2" Height="35" ToolTip="Lance ADB Sideload"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Extracteur XML" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,15"/>
                                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,20" Style="{StaticResource CardGlowStyle}">
                                            <StackPanel>
                                                <TextBlock Text="🔎 Extracteur XML (UI Automator)" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                <TextBlock Text="Récupère l'arborescence complète de l'écran affiché au format .xml (utile pour le paramétrage Velocity / ProGlove)." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                <Button x:Name="BtnDumpUi" Content="📄 Capturer l'écran en XML" Click="BtnDumpUi_Click" Style="{StaticResource PrimaryButtonStyle}" Height="35"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="🔊 Volume" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,15"/>
                                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="15" Style="{StaticResource CardGlowStyle}">
                                            <StackPanel>
                                                <ComboBox x:Name="CmbVolumeStream" Height="28" Margin="0,0,0,10">
                                                    <ComboBoxItem Content="Média" Tag="3" IsSelected="True"/>
                                                    <ComboBoxItem Content="Sonnerie" Tag="2"/>
                                                    <ComboBoxItem Content="Notification" Tag="5"/>
                                                    <ComboBoxItem Content="Alarme" Tag="4"/>
                                                </ComboBox>

                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="−" Click="BtnVolumeMinus_Click" Style="{StaticResource SidebarToggleStyle}" Width="28" Height="28" FontSize="16" Margin="0,0,4,0"/>
                                                    <TextBox x:Name="TxtVolumeValue" Grid.Column="1" Height="28" VerticalContentAlignment="Center" TextAlignment="Center" ToolTip="Index brut, souvent 0 à 15 — varie selon le terminal — Entrée pour valider" KeyDown="TxtVolumeValue_KeyDown"/>
                                                    <Button Content="+" Click="BtnVolumePlus_Click" Style="{StaticResource SidebarToggleStyle}" Width="28" Height="28" FontSize="16" Grid.Column="2" Margin="4,0,0,0"/>
                                                    <Button Content="🔇" ToolTip="Muet (coupe le flux sélectionné)" Click="BtnVolumeMute_Click" Style="{StaticResource OutlineButtonStyle}" Width="36" Height="28" FontSize="13" Grid.Column="4"/>
                                                </Grid>

                                                <TextBlock Text="Mode sonnerie :" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="🔊 Son" Click="BtnRingerNormal_Click" Style="{StaticResource OutlineButtonStyle}" Height="30" Margin="0,0,4,0" ToolTip="⚠️ Peut ne pas fonctionner selon la version Android — non testé sur matériel réel"/>
                                                    <Button Content="📳 Vibreur" Click="BtnRingerVibrate_Click" Style="{StaticResource OutlineButtonStyle}" Height="30" Grid.Column="1" Margin="2,0,2,0" ToolTip="⚠️ Peut ne pas fonctionner selon la version Android — non testé sur matériel réel"/>
                                                    <Button Content="🔕 Silencieux" Click="BtnRingerSilent_Click" Style="{StaticResource OutlineButtonStyle}" Height="30" Grid.Column="2" Margin="4,0,0,0" ToolTip="⚠️ Peut ne pas fonctionner selon la version Android — non testé sur matériel réel"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem>
                            <Grid Margin="15,0,15,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,10" Style="{StaticResource CardGlowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton x:Name="ToggleLogcatRead" Content="▶️ Démarrer" Click="ToggleLogcatRead_Click" Style="{StaticResource ModernToggleStyle}" Height="32" Width="100" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnClearLogDevice" Content="🗑️ Vider (Terminal) " Click="BtnClearLogDevice_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="0,0,10,0" ToolTip="Purge le tampon logcat du téléphone pour repartir sur une capture propre — n'efface pas les logs déjà affichés ici"/>
                                            <Button x:Name="BtnClearLogUI" Content="🧹 Vider la console " Click="BtnClearLogUI_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="0,0,10,0" ToolTip="Efface uniquement l'affichage du logiciel — n'affecte pas le tampon du téléphone"/>
                                            <Button x:Name="BtnNextError" Content="⏭️ Erreur suivante " Click="BtnNextError_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" ToolTip="Sélectionne et affiche la prochaine ligne Erreur/Fatal après la sélection actuelle"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Niveau :" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <RadioButton x:Name="RbLogAll" Content="Tous" IsChecked="True" Checked="LogFilter_Changed" Style="{StaticResource FilterChipStyle}"/>
                                            <RadioButton x:Name="RbLogDebug" Content="🐛 Debug" Checked="LogFilter_Changed" Style="{StaticResource FilterChipStyle}"/>
                                            <RadioButton x:Name="RbLogInfo" Content="ℹ️ Info" Checked="LogFilter_Changed" Style="{StaticResource FilterChipStyle}"/>
                                            <RadioButton x:Name="RbLogWarn" Content="⚠️ Warn" Checked="LogFilter_Changed" Style="{StaticResource FilterChipStyle}"/>
                                            <RadioButton x:Name="RbLogError" Content="❌ Error" Checked="LogFilter_Changed" Style="{StaticResource FilterChipStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Cible :" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="TxtPackageFilter" Tag="(Toutes les applications)" Style="{StaticResource PlaceholderTextBoxStyle}" Width="190" Height="32" VerticalContentAlignment="Center" KeyDown="TxtPackageFilter_KeyDown" ToolTip="Nom de package exact (ex: com.zebra.launcher) — vide = toutes les applications"/>
                                        <Button x:Name="BtnDetectForeground" Content="🎯" Click="BtnDetectForeground_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Width="38" Margin="6,0,0,0" ToolTip="Détecter et cibler l'application actuellement affichée sur le terminal"/>
                                        <ToggleButton x:Name="TogglePackageFilter" Content="🔎" Click="TogglePackageFilter_Click" Style="{StaticResource ModernToggleStyle}" Height="32" Width="38" Margin="6,0,0,0" ToolTip="Activer/désactiver le filtre sur ce nom de package"/>
                                        <Button x:Name="BtnClearPackageFilter" Content="✖" Click="BtnClearPackageFilter_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Width="38" Margin="6,0,0,0" ToolTip="Vider le champ et retirer le filtre"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Recherche :" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="TxtLogSearch" Tag="Filtrer par tag, message ou texte libre…" Style="{StaticResource PlaceholderTextBoxStyle}" Width="240" Height="32" TextChanged="TxtLogSearch_TextChanged" VerticalContentAlignment="Center" ToolTip="Recherche dynamique dans les logs affichés (Tag, Message...) — active .* pour une expression régulière"/>
                                        <ToggleButton x:Name="ToggleLogRegex" Content=".*" Click="LogFilter_Changed" Style="{StaticResource ModernToggleStyle}" Height="30" Width="40" Margin="8,0,0,0" ToolTip="Traiter le texte de recherche comme une expression régulière"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Vue :" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <RadioButton x:Name="RbViewTable" Content="📊 Tableau (Structuré)" IsChecked="True" Checked="ViewMode_Changed" Style="{StaticResource FilterChipStyle}"/>
                                        <RadioButton x:Name="RbViewRaw" Content="💻 Données Brutes" Checked="ViewMode_Changed" Style="{StaticResource FilterChipStyle}" Margin="0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="2" Style="{StaticResource CardGlowStyle}">
                                    <!-- Le Border intérieur garde ClipToBounds pour que les coins carrés du
                                         DataGrid ne dépassent pas du rectangle arrondi — la lueur est donc
                                         posée sur ce Border extérieur non-clippé, sinon elle s'auto-rogne. -->
                                    <Border Background="{DynamicResource ConsoleBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid>
                                        <DataGrid x:Name="LogsDataGrid"
                                                  Visibility="Visible"
                                                  Background="Transparent"
                                                  SelectionMode="Extended" 
                                                  SelectionUnit="FullRow" 
                                                  IsReadOnly="True"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="None"
                                                  RowHeight="25"
                                                  FontSize="12"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling">

                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="E">
                                                            <Setter Property="Foreground" Value="{DynamicResource BadFg}"/>
                                                            <Setter Property="Background" Value="{DynamicResource BadBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="W">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnFg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="I">
                                                            <Setter Property="Foreground" Value="{DynamicResource OkFg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="D">
                                                            <Setter Property="Foreground" Value="{DynamicResource InfoFg}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Heure" Binding="{Binding Time}" Width="100"/>
                                                <DataGridTextColumn Header="PID" Binding="{Binding PID}" Width="60"/>
                                                <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" Width="40"/>
                                                <DataGridTextColumn Header="Application / Tag" Binding="{Binding Tag}" Width="180"/>
                                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <ScrollViewer x:Name="LogsRawScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <TextBox x:Name="TxtLogsRaw" 
                                                     Background="Transparent" 
                                                     Foreground="{DynamicResource BrandText}" 
                                                     BorderThickness="0" 
                                                     IsReadOnly="True" 
                                                     FontFamily="Consolas" 
                                                     FontSize="13" 
                                                     TextWrapping="NoWrap"
                                                     Padding="10"/>
                                        </ScrollViewer>
                                    </Grid>
                                    </Border>
                                </Border>

                                <Grid Grid.Row="3" Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="ChkAutoScroll" Content="Défilement Automatique" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" Margin="0"/>

                                    <TextBlock x:Name="TxtLogStats" Grid.Column="1" Text="Lignes affichées : 0 / 10000" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="BtnCopyLogs" Content="📋 Copier la sélection" Click="BtnCopyLogs_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Width="160" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnSaveLogs" Content="💾 Sauvegarder (.txt)" Click="BtnSaveLogs_Click" Style="{StaticResource PrimaryButtonStyle}" Height="35" Width="160" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnBugReport" Content="☢️ GÉNÉRER BUGREPORT (.zip)" Click="BtnBugReport_Click" Style="{StaticResource DangerButtonStyle}" Height="35" Width="200" ToolTip="Exporte toutes les données vitales du terminal pour le constructeur (Zebra/Samsung)"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <Grid Margin="15,0,15,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Banc de Test &amp; Contrôle Qualité" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                                        <Button x:Name="BtnExportRma" Content="💾 Exporter (JSON)" Click="BtnExportRma_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Width="160" Margin="0,0,10,0"
                                                ToolTip="Exporte le rapport SAV brut au format JSON (données uniquement, sans mise en page)."/>
                                        <Button x:Name="BtnReportTemplateSav" Content="⚙️ Modèle : fourni" Tag="Sav" Click="BtnReportTemplate_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Padding="14,0" Margin="0,0,10,0"
                                                ToolTip="Choisir, modifier ou importer le modèle Word du rapport SAV."/>
                                        <Button x:Name="BtnExportWord" Content="📝 Exporter (Word)" Click="BtnExportWord_Click" Style="{StaticResource PrimaryButtonStyle}" Height="35" Width="170"
                                                ToolTip="Génère le rapport SAV complet dans le modèle Word (infos terminal, résultats par module, visuels des tests tactile/boutons)."/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="380"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="15" Style="{StaticResource CardGlowStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnRunAutoCheck" Content="▶️ Lancer le Check-up Auto" Click="BtnRunAutoCheck_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" ToolTip="Teste automatiquement le Wi-Fi, la Batterie, le Root et le Ping"/>
                                                <Button x:Name="BtnResetDiagnostic" Content="🔄" Click="BtnResetDiagnostic_Click" Style="{StaticResource DangerButtonStyle}" Height="40" Width="40" Margin="8,0,0,0" Grid.Column="1"
                                                        ToolTip="Nouveau test : réinitialise entièrement le diagnostic (statuts et commentaires Auto + Manuel, grille tactile, journal des touches). Le terminal sélectionné n'est pas affecté."/>
                                            </Grid>

                                            <DataGrid x:Name="DiagChecklistGrid"
                                                      Grid.Row="1"
                                                      Background="Transparent"
                                                      SelectionMode="Single" 
                                                      SelectionUnit="FullRow" 
                                                      IsReadOnly="True"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="None"
                                                      GridLinesVisibility="None"
                                                      RowHeight="35"
                                                      FontSize="14"
                                                      SelectionChanged="DiagChecklistGrid_SelectionChanged">

                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Binding="{Binding StatusIcon}" Width="40">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Binding="{Binding ComponentName}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition x:Name="LabRowDefinition" Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border x:Name="InspectorBorder" Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15" Style="{StaticResource CardGlowStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtDiagTitle" Text="Sélectionnez un composant à tester" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                                    <Button x:Name="BtnToggleInspector" Content="▾" ToolTip="Réduire" Click="BtnToggleInspector_Click" Grid.Column="1" Style="{StaticResource SidebarToggleStyle}" Width="26" Height="26" FontSize="13"/>
                                                </Grid>

                                                <StackPanel x:Name="InspectorBody">
                                                    <Border Background="{DynamicResource Surface2}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <TextBlock x:Name="TxtDiagDetails" Text="Les informations techniques apparaîtront ici." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                                        </ScrollViewer>
                                                    </Border>

                                                    <Grid x:Name="GridDiagValidation" Visibility="Collapsed">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="15"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Commentaire technicien (Optionnel) :" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                                                            <TextBox x:Name="TxtDiagComment" Height="40" VerticalContentAlignment="Top" Padding="5" TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <Button x:Name="BtnDiagFail" Content="❌ FAIL" Click="BtnDiagFail_Click" Style="{StaticResource StatusFailButtonStyle}" Width="100" Height="40" Grid.Column="2" Margin="0,20,10,0"/>
                                                        <Button x:Name="BtnDiagPass" Content="✅ PASS" Click="BtnDiagPass_Click" Style="{StaticResource StatusPassButtonStyle}" Width="100" Height="40" Grid.Column="3" Margin="0,20,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="20" Style="{StaticResource CardGlowStyle}">
                                            <!-- ScrollViewer : si la console en bas est agrandie, cette carte se retrouve à l'étroit.
                                                 Sans scroll, le Laboratoire GetEvent et le Test d'Écran étaient coupés sans moyen d'y accéder. -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="🕹️ Laboratoire Matériel Live (GetEvent)" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,5"/>
                                                        <TextBlock Text="Détection matérielle des boutons physiques, de la gâchette et de la dalle tactile." Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <ToggleButton x:Name="ToggleLabListen" Content="Démarrer l'écoute" Click="ToggleLabListen_Click" Style="{StaticResource ModernToggleStyle}" Width="140" Height="35" Margin="0,0,8,0"/>
                                                        <Button x:Name="BtnToggleLabCard" Content="▾" ToolTip="Réduire le Laboratoire" Click="BtnToggleLabCard_Click" Style="{StaticResource SidebarToggleStyle}" Width="26" Height="26" FontSize="13"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid x:Name="LabBodyGetEvent" Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{DynamicResource Surface2}" CornerRadius="8" Padding="15">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="BOUTONS PHYSIQUES" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                                <Button x:Name="BtnResetKeyHistory" Content="↺" ToolTip="Réinitialiser l'historique" Click="BtnResetKeyHistory_Click" Grid.Column="1" Style="{StaticResource SidebarToggleStyle}" Width="26" Height="26" FontSize="13"/>
                                                            </Grid>

                                                            <TextBlock x:Name="TxtLabLastKey" Grid.Row="1" Text="-" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" Margin="0,8,0,8"/>

                                                            <Border x:Name="AlertStuckKey" Grid.Row="2" Background="{DynamicResource BadBg}" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                                                                <TextBlock Text="⚠️ TOUCHE COINCÉE DÉTECTÉE !" Foreground="{DynamicResource DangerColor}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Pas de ScrollViewer imbriqué ici : un scroll interne piège la molette dès qu'on
                                                                 atteint le haut/bas de la liste, empêchant de remonter vers le bouton "Démarrer
                                                                 l'écoute" au-dessus. La hauteur est réglée explicitement en code (avec celle de la
                                                                 grille tactile, voir BtnExpandTouchGrid_Click) plutôt que liée en XAML à l'ActualHeight
                                                                 d'un autre élément de la même ligne : ce genre de binding croisé dans une ligne de
                                                                 Grid "Auto" crée une boucle de mise en page (measure/arrange en cascade) qui a rendu
                                                                 tout le programme lent. Le surplus de contenu est simplement coupé proprement ; le
                                                                 détail complet reste consultable dans la checklist SAV une fois le test terminé. -->
                                                            <Border x:Name="KeyHistoryBorder" Grid.Row="3" Height="150" ClipToBounds="True">
                                                                <ItemsControl x:Name="KeyHistoryList">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource BorderColor}" CornerRadius="10" Padding="8,3" Margin="0,0,5,5">
                                                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Ink}" FontSize="11"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <Border x:Name="TouchLabCard" Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="8" Padding="15">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="TACTILE — GRILLE DE ZONES" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <Button x:Name="BtnExpandTouchGrid" Content="⤢" ToolTip="Agrandir la zone de test (grille + historique)" Click="BtnExpandTouchGrid_Click" Style="{StaticResource SidebarToggleStyle}" Width="26" Height="26" FontSize="13"/>
                                                                    <Button x:Name="BtnResetTouchGrid" Content="↺" ToolTip="Réinitialiser la grille" Click="BtnResetTouchGrid_Click" Style="{StaticResource SidebarToggleStyle}" Width="26" Height="26" FontSize="13"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8">
                                                                <TextBlock x:Name="TxtLabTouchX" Text="X: 0000" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,0,15,0"/>
                                                                <TextBlock x:Name="TxtLabTouchY" Text="Y: 0000" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                                            </StackPanel>

                                                            <Viewbox x:Name="TouchGridViewbox" Grid.Row="2" Stretch="Uniform" MaxHeight="150" Margin="0,0,0,8">
                                                                <UniformGrid x:Name="TouchZoneGridPanel"/>
                                                            </Viewbox>

                                                            <TextBlock x:Name="TxtTouchGridStats" Grid.Row="3" Text="Faites glisser votre doigt sur tout l'écran pour tester chaque zone." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>

                                                <StackPanel x:Name="LabBodyScreenTest" Grid.Row="2" Margin="0,15,0,0">
                                                    <TextBlock Text="🖥️ Test d'Écran (Pixels Morts / Brûlure)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,5"/>
                                                    <TextBlock Text="Affiche une mire plein écran (résolution exacte de l'appareil + barres système masquées automatiquement) sur le terminal. Comparez chaque couleur à la recherche de pixels morts, de taches ou de traces de brûlure (burn-in). Un premier tap sur l'appareil masque l'interface de la visionneuse. Cliquez sur 'Nettoyer' en fin de test pour restaurer l'affichage normal." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="BtnScreenTestRed" Content="Rouge" Click="BtnScreenTestColor_Click" Tag="Red" Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF5252" Foreground="White" Width="78" Height="32" Margin="0,0,8,0"/>
                                                        <Button x:Name="BtnScreenTestGreen" Content="Vert" Click="BtnScreenTestColor_Click" Tag="Green" Style="{StaticResource ColorSwatchButtonStyle}" Background="#4CAF50" Foreground="White" Width="78" Height="32" Margin="0,0,8,0"/>
                                                        <Button x:Name="BtnScreenTestBlue" Content="Bleu" Click="BtnScreenTestColor_Click" Tag="Blue" Style="{StaticResource ColorSwatchButtonStyle}" Background="#2196F3" Foreground="White" Width="78" Height="32" Margin="0,0,8,0"/>
                                                        <Button x:Name="BtnScreenTestWhite" Content="Blanc" Click="BtnScreenTestColor_Click" Tag="White" Style="{StaticResource ColorSwatchButtonStyle}" Background="White" Foreground="Black" Width="78" Height="32" Margin="0,0,8,0"/>
                                                        <Button x:Name="BtnScreenTestBlack" Content="Noir" Click="BtnScreenTestColor_Click" Tag="Black" Style="{StaticResource ColorSwatchButtonStyle}" Background="Black" Foreground="White" Width="78" Height="32" Margin="0,0,8,0"/>
                                                        <Button x:Name="BtnScreenTestGray" Content="Gris 50%" Click="BtnScreenTestColor_Click" Tag="Gray" Style="{StaticResource ColorSwatchButtonStyle}" Background="#808080" Foreground="White" Width="78" Height="32" Margin="0,0,16,0"/>
                                                        <Button x:Name="BtnScreenTestCleanup" Content="🗑️ Nettoyer" Click="BtnScreenTestCleanup_Click" Style="{StaticResource DangerButtonStyle}" Width="110" Height="32" ToolTip="Supprime les images de test envoyées sur le terminal"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            </ScrollViewer>
                                        </Border>

                                    </Grid>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="📚 BIBLIOTHÈQUE ADB">
                            <Grid Margin="15,0,15,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCard}" CornerRadius="10" Padding="15" Margin="0,0,0,15" Style="{StaticResource CardGlowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="🔍 Recherche :" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="TxtSearchCommand" Tag="Mot-clé ou commande…" Style="{StaticResource PlaceholderTextBoxStyle}" Grid.Column="1" Height="32" TextChanged="FilterLibrary_Changed" VerticalContentAlignment="Center" ToolTip="Chercher un mot-clé ou une commande..."/>

                                        <ComboBox x:Name="CmbCategoryFilter" Grid.Column="2" Height="32" Margin="15,0,0,0" VerticalContentAlignment="Center" SelectionChanged="FilterLibrary_Changed">
                                            <ComboBoxItem Content="Toutes les catégories" IsSelected="True"/>
                                            <ComboBoxItem Content="Accessibilité"/>
                                            <ComboBoxItem Content="Affichage"/>
                                            <ComboBoxItem Content="Batterie"/>
                                            <ComboBoxItem Content="GPS"/>
                                            <ComboBoxItem Content="Info"/>
                                            <ComboBoxItem Content="Input"/>
                                            <ComboBoxItem Content="Matériel"/>
                                            <ComboBoxItem Content="MDM"/>
                                            <ComboBoxItem Content="Packages"/>
                                            <ComboBoxItem Content="Réseau"/>
                                            <ComboBoxItem Content="Sécurité"/>
                                            <ComboBoxItem Content="Stockage"/>
                                            <ComboBoxItem Content="Système"/>
                                        </ComboBox>

                                        <Button x:Name="BtnExportLibrary" Grid.Column="3" Content="⬆️ Exporter " Click="BtnExportLibrary_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="15,0,0,0" ToolTip="Exporter la bibliothèque actuelle dans un fichier .json à partager avec l'équipe"/>
                                        <Button x:Name="BtnImportLibrary" Grid.Column="4" Content="⬇️ Importer " Click="BtnImportLibrary_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="10,0,0,0" ToolTip="Importer un fichier .json de bibliothèque partagé par un collègue (fusion, ne supprime rien)"/>

                                        <Button x:Name="BtnShowAddForm" Grid.Column="5" Content="+ Nouvelle Commande" Click="BtnShowAddForm_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="15,0,0,0"/>
                                        <Button x:Name="BtnMultiDeviceFreeCommand" Grid.Column="6" Content="🖥️ Cmd. Multi." Click="BtnMultiDeviceFreeCommand_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="10,0,0,0" ToolTip="Taper une commande ADB libre et l'exécuter sur plusieurs appareils connectés à la fois"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="PanelAddCommand" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource BgCard}" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="✨ AJOUTER UNE NOUVELLE COMMANDE ADB" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,15"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.5*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                                <TextBlock Text="Titre (Description)" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                                <TextBox x:Name="TxtNewTitle" Height="32" VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                                <TextBlock Text="Commande (ex: shell uptime)" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                                <TextBox x:Name="TxtNewCommand" Height="32" VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="0,0,15,0">
                                                <TextBlock Text="Catégorie (ex: Réseau)" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                                <TextBox x:Name="TxtNewCategory" Height="32" VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="OS Min" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                                <TextBox x:Name="TxtNewAndroid" Height="32" VerticalContentAlignment="Center" Text="4.0"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                            <Button Content="Annuler" Click="BtnShowAddForm_Click" Style="{StaticResource OutlineButtonStyle}" Width="100" Height="32" Margin="0,0,10,0"/>
                                            <Button Content="✔️ Enregistrer" Click="BtnSaveNewCmd_Click" Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="32"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <DataGrid x:Name="AdbLibraryGrid" Grid.Row="2" Background="Transparent" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="40">

                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                Padding="10,0">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="120" Foreground="{DynamicResource AccentColor}"/>
                                        <DataGridTextColumn Header="Description / Action" Binding="{Binding Title}" Width="250" Foreground="{DynamicResource Ink}" />
                                        <DataGridTextColumn Header="Commande ADB" Binding="{Binding Command}" Width="300" FontFamily="Consolas" Foreground="{DynamicResource Muted}"/>
                                        <DataGridTextColumn Header="Android" Binding="{Binding AndroidRange, Mode=OneWay}" Width="80" Foreground="{DynamicResource TextSecondary}"/>

                                        <DataGridTemplateColumn Header="Actions" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="▶ Exécuter" Click="BtnExecuteLibraryCmd_Click" Style="{StaticResource OutlineButtonStyle}" Width="90" Height="28" Margin="0,0,8,0"/>
                                                        <Button Content="▶▶ Multi" Click="BtnExecuteLibraryCmdMulti_Click" Style="{StaticResource OutlineButtonStyle}" Width="70" Height="28" ToolTip="Exécuter cette commande sur plusieurs appareils connectés à la fois" Margin="0,0,8,0"/>
                                                        <Button Content="📋 Copier" Click="BtnCopyLibraryCmd_Click" Style="{StaticResource OutlineButtonStyle}" Width="80" Height="28" ToolTip="Copier la commande pour un script" Margin="0,0,15,0"/>
                                                        <Button Content="🗑️" Click="BtnDeleteCmd_Click" Style="{StaticResource DangerButtonStyle}" Width="30" Height="28" ToolTip="Supprimer cette commande" FontSize="13"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="📡 RADAR WI-FI">
                            <Grid Margin="15,0,15,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCard}" CornerRadius="10" Padding="15" Margin="0,0,0,15" Style="{StaticResource CardGlowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="RÉSEAU ACTUEL" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtWifiSsid" Text="En attente..." Foreground="{DynamicResource Ink}" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                                            <TextBlock x:Name="TxtWifiBssid" Text="BSSID : --:--:--:--:--:--" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtWifiIp" Text="IP : ---.---.---.---" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtWifiMac" Text="MAC : --:--:--:--:--:--" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,2,0,0" ToolTip="L'adresse MAC peut être aléatoire sous Android 10+"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="SIGNAL (RSSI)" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtWifiRssi" Text="- dBm" Foreground="{DynamicResource AccentColor}" FontSize="28" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtWifiFreq" Text="Bande : -- / Canal : --" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="VITESSE &amp; ROUTAGE" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtWifiSpeed" Text="- Mbps" Foreground="{DynamicResource AccentColor}" FontSize="28" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtWifiGateway" Text="Passerelle : ---.---.---.---" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,5,0,0"/>
                                            <TextBlock x:Name="TxtWifiDns" Text="DNS : ---.---.---.---" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Button x:Name="BtnToggleRadar" Content="▶ DÉMARRER" Click="BtnToggleRadar_Click" Style="{StaticResource PrimaryButtonStyle}" Height="40" Margin="0,0,0,8"/>
                                            <Button x:Name="BtnExportRadar" Content="💾 Générer Rapport" Click="BtnExportRadarReport_Click" Style="{StaticResource OutlineButtonStyle}" Height="30" Margin="0,0,0,8"
                                                    ToolTip="Exporte un rapport texte brut (chiffres + config réseau + journal), sans graphique."/>
                                            <Button x:Name="BtnExportRadarWord" Content="📝 Rapport Word" Click="BtnExportRadarWordReport_Click" Style="{StaticResource OutlineButtonStyle}" Height="30" Margin="0,0,0,8"
                                                    ToolTip="Génère le rapport complet au format Word, avec les graphiques Ping/RSSI, pour le client."/>
                                            <Button x:Name="BtnReportTemplateWifi" Content="⚙️ Modèle : fourni" Tag="Wifi" Click="BtnReportTemplate_Click" Style="{StaticResource OutlineButtonStyle}" Height="30" Margin="0,0,0,8"
                                                    ToolTip="Choisir, modifier ou importer le modèle Word du rapport Wi-Fi."/>
                                            <Button x:Name="BtnResetRadar" Content="🔄 Réinitialiser" Click="BtnResetRadar_Click" Style="{StaticResource DangerButtonStyle}" Height="30" ToolTip="Efface les statistiques et le graphique de la session en cours — irréversible"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="10" Padding="15" Margin="0,0,0,15" Style="{StaticResource CardGlowStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="📈 STABILITÉ DE LA CONNEXION" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Latence Ping (ms)" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                                                    <TextBlock x:Name="TxtPingCount" Text="Envoyés : 0" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,12,0"/>
                                                    <TextBlock x:Name="TxtPingLatency" Text="Latence : -- ms" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,12,0"/>

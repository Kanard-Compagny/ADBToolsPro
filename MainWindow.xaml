<Window x:Class="ADBToolsNew.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:ADBToolsNew"
        Title="ADB Tools Pro 2027" Height="800" Width="1400"
        Background="Transparent" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        Icon="app_icon.ico"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" ResizeBorderThickness="10" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
        <!-- Couleurs de la charte (BgPrimary/BgCard/BorderColor/AccentColor/TextSecondary/StatusSuccess/
             DangerColor) : plus définies ici — elles viennent de Resources/Colors.xaml, fusionné au niveau
             de l'application (App.xaml) et donc déjà partagé avec le SplashScreen. Les redéfinir ici en
             double aurait pu un jour désynchroniser silencieusement les deux fenêtres. -->

        <!-- Glow blanc cassé neutre pour les cartes de contenu sans donnée à couleur variable (les 4
             cartes de statistiques du Dashboard ont leur propre glow coloré par statut, voir GlowBattery/
             GlowRam/GlowCpu/GlowStorage). Un seul Style partagé : réglable en un seul endroit. -->
        <Style x:Key="CardGlowStyle" TargetType="Border">
            <Setter Property="Effect" Value="{x:Null}"/>
            <!-- Ancien halo désactivé (charte Scanalyse : cartes plates) -->
            <!--<Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#F2EFE6" ShadowDepth="0" BlurRadius="15" Opacity="0.4"/>
                </Setter.Value>
            </Setter>-->
        </Style>

        <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="{DynamicResource ScrollThumb}" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Muted}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource BrandText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="MenuButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SideInk}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Margin="10,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SideHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SideActiveInk}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SidebarToggleStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Surface2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton icône posé sur le menu latéral vert (réduction du menu) -->
        <Style TargetType="Button" x:Key="SideIconButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SideMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SideHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SideInk}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowControlStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleInk}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverBubble" Background="{TemplateBinding Background}" CornerRadius="4" Margin="5,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Bulle pleine + icône blanche au survol (pas la même teinte pour les
                                     deux) pour rester lisible, plutôt que l'icône seule qui passait en
                                     orange sur fond transparent. -->
                                <Setter TargetName="HoverBubble" Property="Background" Value="{DynamicResource TitleHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleInk}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowCloseStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleInk}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverBubble" Background="{TemplateBinding Background}" CornerRadius="4" Margin="5,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBubble" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="{DynamicResource Action}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAction}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActionHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="OutlineButtonStyle">
            <!-- Bouton secondaire, façon Scanalyse : fond de bloc, bordure fine, texte principal. -->
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Muted}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton" x:Key="FilterChipStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandText}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrandText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Focus}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox standard + texte fantôme (via Tag) affiché quand le champ est vide : WPF n'a pas
             d'équivalent natif à "placeholder". Un TextBlock superposé au ScrollViewer de contenu,
             dont la visibilité bascule sur un ControlTemplate.Trigger, est plus fiable qu'un VisualBrush
             posé sur Background (qui ne se déclenchait pas de façon fiable en pratique). -->
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <Grid>
                                <TextBlock x:Name="PlaceholderText" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="false" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                                            <Path x:Name="Arrow" Fill="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L4,4 8,0 z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                              TextBlock.Foreground="{DynamicResource Ink}" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" CornerRadius="5" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,4,0,0">
                                    <ScrollViewer Margin="2,4,2,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrandSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DangerButtonStyle">
            <!-- Action risquée : fond rouge pâle, texte et bordure rouges (lisible dans les deux thèmes). -->
            <Setter Property="Background" Value="{DynamicResource BadBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BadFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadFg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Styles dédiés au verdict Pass/Fail du Diagnostic SAV : visuellement identiques à Danger/Primary
             (rouge/vert) mais nommés pour ce qu'ils représentent réellement — un statut, pas une action
             destructrice ou l'action principale d'une carte — pour ne pas détourner la sémantique de ces
             deux styles ailleurs dans l'app. -->
        <Style TargetType="Button" x:Key="StatusFailButtonStyle">
            <!-- Verdict « échec » du Diagnostic SAV. -->
            <Setter Property="Background" Value="{DynamicResource BadBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BadFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadFg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="StatusPassButtonStyle">
            <!-- Verdict « conforme » du Diagnostic SAV. -->
            <Setter Property="Background" Value="{DynamicResource OkBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource OkFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OkFg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Boutons de mire couleur (Test d'Écran) : chaque bouton porte sa propre couleur via Background
             (pas un style figé comme Primary/Danger), mais doit quand même suivre les coins arrondis de la
             DA du reste de l'app plutôt que le chrome par défaut de WPF. -->
        <Style TargetType="Button" x:Key="ColorSwatchButtonStyle">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox" x:Key="ModernCheckBoxStyle">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Border" Width="20" Height="20" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource BorderColor}" Background="{DynamicResource Check}" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Visibility="Collapsed" Width="10" Height="10" Stretch="Fill" Fill="{DynamicResource OnBrand}" Data="M 0,5 L 4,9 L 11,0 L 12,1 L 4,11 L -1,6 Z"/>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brand}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Brand}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton" x:Key="ModernToggleStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brand}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnBrand}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource SideActiveBg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar" x:Key="ModernProgressBarStyle">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <!-- Deux modes : un remplissage proportionnel classique (Value/Maximum/ActualWidth,
                             au cas où une progression exacte arrive un jour), et un mode "occupé" par défaut
                             (IsIndeterminate) qui anime un bloc en va-et-vient sans dépendre d'aucune donnée
                             d'adb — celle-ci ne dépend que du chronomètre WPF, donc garantie de s'animer. -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                <Border x:Name="IndeterminateChunk" Background="{TemplateBinding Foreground}" CornerRadius="4" Width="70" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ChunkTransform" X="-70"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IndeterminateChunk" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="IndeterminateStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChunkTransform" Storyboard.TargetProperty="X"
                                                             From="-70" To="300" Duration="0:0:1.1" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="IndeterminateStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===== Page Paramètres (même organisation que Scanalyse) ===== -->
        <!-- Lien du sous-menu de gauche -->
        <Style x:Key="SettingsNavStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrandText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titre de groupe du sous-menu (APPLICATION, ADB TOOLS) -->
        <Style x:Key="SettingsGroupLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="12,14,0,6"/>
        </Style>

        <!-- Bloc de réglages -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Carte de choix (ex. thème Système / Clair / Sombre) -->
        <Style x:Key="SettingsChoiceStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Muted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Cadre de la fenêtre : coins arrondis et ombre douce en fenêtre normale, plein écran sans marge
         une fois agrandie (voir UpdateWindowFrame). L'ombre est portée par un cadre vide DERRIÈRE le
         contenu : un effet posé sur le conteneur rendrait tout le texte flou (rendu sans ClearType). -->
    <Grid x:Name="WindowFrameGrid" Background="#01000000">
    <Border x:Name="WindowShadow" Margin="12" CornerRadius="10" Background="{DynamicResource BgPrimary}">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="3" BlurRadius="18" Opacity="0.35" Color="Black"/>
        </Border.Effect>
    </Border>
    <Border x:Name="RootBorder" Margin="12" CornerRadius="10" Background="{DynamicResource BgPrimary}" BorderBrush="{DynamicResource Line}" BorderThickness="1" SizeChanged="RootBorder_SizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource TitleBg}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="ADB Tools Pro" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TitleInk}" FontFamily="{DynamicResource FontDisplay}" VerticalAlignment="Center"/>
                    <TextBlock Text="  Édition 2027" FontSize="13" Foreground="{DynamicResource TitleMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1" Width="200" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Trapèze (plus large en haut) plutôt qu'un rectangle plein, avec le même remplissage/
                         bordure que les cartes et une lueur blanc cassé assortie (voir CardGlowStyle). -->
                    <Polygon Points="0,0 200,0 180,34 20,34" Fill="{DynamicResource TitleHover}"/>
                    <Image Source="/Resources/logo_adbtools.png"
                           Height="26"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="—" Click="BtnMinimize_Click" Width="45" Height="35" Style="{StaticResource WindowControlStyle}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="BtnMaximize" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="BtnMaximize_Click" Width="45" Height="35" Style="{StaticResource WindowControlStyle}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕" Click="BtnClose_Click" Width="45" Height="35" Style="{StaticResource WindowCloseStyle}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- Barre de connexion : pleine largeur, sous la barre de titre, visible en permanence quel que
                 soit l'onglet actif et indépendante de l'état replié/déplié de la sidebar (avant, elle
                 vivait dans la colonne de 260px de la sidebar, ce qui la rendait trop à l'étroit). -->
            <!-- Padding gauche 29 (au lieu de 15) : aligne le centre du point de statut sur le centre des
                 icônes du menu en dessous (Margin=10 du template MenuButtonStyle + moitié de leur zone de
                 50px = 35px depuis le bord de la fenêtre). -->
            <Border Grid.Row="1" Background="{DynamicResource ToolbarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="29,10,15,10">
                <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="{DynamicResource DangerColor}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Déconnecté"/>
                    <ComboBox x:Name="DeviceComboBox" Width="220" Height="32" DisplayMemberPath="DisplayName" SelectionChanged="DeviceComboBox_SelectionChanged" Margin="0,0,10,0"/>
                    <Button x:Name="BtnConnect" Click="BtnConnect_Click" Content="Connecter" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="32" FontSize="12" Margin="0,0,6,0"/>
                    <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Content="↺" ToolTip="Actualiser la liste des appareils" Style="{StaticResource SidebarToggleStyle}" Width="32" Height="32" FontSize="16" Margin="0,0,14,0"/>

                    <Button x:Name="BtnDevOff" Click="BtnDevOff_Click" Style="{StaticResource DangerButtonStyle}" Height="32" FontFamily="Segoe UI Emoji" Margin="0,0,6,0" ToolTip="Désactiver le mode développeur (révoque l'accès ADB)">
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Dev Off" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnReload" Click="BtnReload_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" FontFamily="Segoe UI Emoji" Margin="0,0,6,0" ToolTip="Redémarrage classique">
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Redémarrer" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRecovery" Click="BtnRecovery_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" FontFamily="Segoe UI Emoji" Margin="0,0,14,0" ToolTip="Redémarrage en mode Recovery">
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <TextBlock Text="🛠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Recovery Mode" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnWifiPairingToggle" Click="BtnWifiPairingToggle_Click" Style="{StaticResource SidebarToggleStyle}" Height="32">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <TextBlock Text="📡" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Wi-Fi Pairing" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Popup x:Name="WifiPairingPopup" PlacementTarget="{Binding ElementName=BtnWifiPairingToggle}" Placement="Bottom" StaysOpen="False" Closed="WifiPairingPopup_Closed">
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="15" Width="280">
                            <StackPanel>
                                <TextBlock Text="1. Mode Classique (Android 10- ou via USB)" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="Bascule le terminal USB actuel en mode Wi-Fi." Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <Button x:Name="BtnWifiLegacy" Content="Auto-Connecter (USB ➔ Wi-Fi)" Click="BtnWifiLegacy_Click" Style="{StaticResource OutlineButtonStyle}" Height="30" FontSize="11" Margin="0,0,0,15"/>
                                <TextBlock Text="2. Mode Moderne (Android 11+ sans câble)" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="Sur le terminal : Options développeur &gt; Débogage sans fil." Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Étape A — Notez le port affiché sur l'écran principal (il sera caché dès que vous ouvrirez l'écran de pairage) :" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <TextBox x:Name="TxtWifiConnectPort" ToolTip="Port de connexion, affiché sur l'écran principal 'Débogage sans fil' avant d'ouvrir l'écran de pairage — ex: 38555"/>
                                    <TextBlock Text="Port connexion" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False" Opacity="0.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtWifiConnectPort}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="Étape B — Coupler (bouton 'Coupler avec un code') :" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtWifiPairIp" ToolTip="IP:Port de pairage, affichés sur l'écran 'Coupler avec un code' (ex: 192.168.1.15:40500)" Margin="0,0,5,0"/>
                                    <TextBlock Text="IP:Port pairage" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False" Opacity="0.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtWifiPairIp}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtWifiPairCode" Grid.Column="1" MaxLength="6" ToolTip="Code PIN à 6 chiffres, affiché sur le même écran 'Coupler avec un code'"/>
                                    <TextBlock Grid.Column="1" Text="Code" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False" Opacity="0.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtWifiPairCode}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button x:Name="BtnWifiModern" Content="Associer &amp; Connecter" Click="BtnWifiModern_Click" Style="{StaticResource PrimaryButtonStyle}" Height="30" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Dossier des captures : ouvrir / vider (comme « Dossier » dans Scanalyse) -->
                <Button x:Name="BtnCapturesMenu" Click="BtnCapturesMenu_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="0,0,8,0"
                        ToolTip="Captures d'écran, vidéos, logs et rapports générés">
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Captures" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Thème : Système → Clair → Sombre (comme Scanalyse) -->
                <Button x:Name="BtnThemeMode" Click="BtnThemeMode_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" VerticalAlignment="Center"
                        ToolTip="Changer de thème : Système (comme Windows), Clair ou Sombre">
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <TextBlock x:Name="TxtThemeModeIcon" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtThemeModeLabel" Text="Thème : Système" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SideBg}" BorderThickness="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="10,20,10,20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" x:Name="SidebarLogoGroup">
                                <Image Source="/Resources/logo_adbtools.png" Height="24" Margin="10,0,10,0" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SideMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="BtnToggleSidebar" Click="BtnToggleSidebar_Click" Content="◀" Style="{StaticResource SideIconButtonStyle}" FontSize="14" HorizontalAlignment="Right" Width="30" Height="30"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Barre de défilement du menu : teinte verte assortie au menu (au lieu du gris des pages).
                                 Elle n'apparaît que si le menu ne tient pas en hauteur (VerticalScrollBarVisibility=Auto). -->
                            <ScrollViewer.Resources>
                                <SolidColorBrush x:Key="ScrollThumb" Color="{DynamicResource C.SideActiveBg}"/>
                                <SolidColorBrush x:Key="Muted" Color="{DynamicResource C.SideMuted}"/>
                                <SolidColorBrush x:Key="BrandText" Color="{DynamicResource C.SideInk}"/>
                            </ScrollViewer.Resources>
                            <StackPanel>

                                <Button x:Name="BtnNavDashboard" Click="NavDashboard_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📱" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Device Info" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnNavMirroring" Click="NavMirroring_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📺" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mirroring" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnNavPackages" Click="NavPackages_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Package Manager" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnNavExplorer" Click="NavExplorer_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Explorer" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnNavTools" Click="NavTools_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Outils Avancés" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnNavDiag" Click="NavDiag_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔧" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Diagnostics SAV" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnNavRadar" Click="NavRadar_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📡" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Analyse Wi-Fi" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnNavLibrary" Click="NavLibrary_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📚" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bibliothèque ADB" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnNavLogs" Click="NavLogs_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Logs" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,10,0,20">

                            <!-- Paramètres : thème, outils tiers, modèles de rapport, à propos / licence
                                 (remplace l'ancien groupe « Informations »). -->
                            <Button x:Name="BtnNavSettings" Click="NavSettings_Click" Style="{StaticResource MenuButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" Width="50" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Paramètres" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SidebarLogoGroup}"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="12" />
                        <RowDefinition x:Name="ConsoleRowDefinition" Height="250" MinHeight="100" />
                    </Grid.RowDefinitions>

                    <TabControl x:Name="MainTabControl" Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <Grid Margin="15,0,15,0">
                                    <!-- La connexion (statut, sélecteur, actions terminal, Wi-Fi Pairing) vit
                                         désormais en haut de la sidebar, visible depuis tous les onglets ; ce
                                         Dashboard occupe donc toute la largeur disponible ici. -->
                                    <Grid>

            <!-- Sélecteur d'appareils + lanceur de commande multi-terminaux (Bibliothèque ADB). Même
                 famille visuelle que OverlayDialog ci-dessus : carte centrée, CardGlowStyle, styles de
                 boutons standards. La liste des CheckBox est construite dynamiquement en code-behind
                 (MainWindow.MultiDevice.cs) plutôt que par data-binding : plus simple et cohérent avec le
                 reste de l'app, qui n'utilise pas de pattern MVVM/INotifyPropertyChanged. -->
            <Grid x:Name="MultiDeviceOverlay" Visibility="Collapsed" Background="#D8000000" Grid.RowSpan="3" Panel.ZIndex="999">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25" Style="{StaticResource CardGlowStyle}">
                    <StackPanel>
                        <TextBlock x:Name="TxtMultiDeviceTitle" Text="🖥️ Exécuter sur plusieurs appareils" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <StackPanel x:Name="MultiDeviceFieldPanel">
                            <TextBlock x:Name="TxtMultiDeviceFieldLabel" Text="Commande" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtMultiDeviceCommand" Height="32" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="10,0" FontFamily="Consolas" Tag="ex: shell reboot"/>
                        </StackPanel>

                        <TextBlock Text="Appareils cibles (non autorisés/hors-ligne grisés)" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" MaxHeight="220" Margin="0,0,0,15">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MultiDeviceCheckList" Margin="12,8"/>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnMultiDeviceSelectAll" Content="Tout sélectionner" Click="BtnMultiDeviceSelectAll_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="0,0,10,0"/>
                            <Button x:Name="BtnMultiDeviceCancel" Content="Annuler" Click="BtnMultiDeviceCancel_Click" Style="{StaticResource OutlineButtonStyle}" Width="90" Height="32" Margin="0,0,10,0"/>
                            <Button x:Name="BtnMultiDeviceRun" Content="Exécuter" Click="BtnMultiDeviceRun_Click" Style="{StaticResource PrimaryButtonStyle}" Width="150" Height="32" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Visionneuse de document (CGU / Notes de version) : même famille visuelle que les overlays
                 ci-dessus. Deux modes : acceptation obligatoire (premier lancement du CGU, boutons
                 J'accepte/Refuser) ou simple consultation (bouton Fermer, accès à la demande depuis le
                 pied de la sidebar). -->
            <!-- Outils tiers (adb/fastboot, scrcpy, FFmpeg) : versions installées, mises à jour, téléchargement.
                 Les lignes sont construites dans MainWindow.Tools.cs. -->
            <Grid x:Name="ToolsOverlay" Visibility="Collapsed" Background="#D8000000" Grid.RowSpan="3" Panel.ZIndex="999">
                <Border Width="720" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Outils tiers" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" FontFamily="{DynamicResource FontDisplay}"/>
                            <TextBlock Text="Téléchargés depuis leurs sources officielles dans le dossier Tools, à côté du programme. Rien n'est installé dans Windows."
                                       Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ToolsList"/>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock x:Name="TxtToolsStatus" Text="" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ProgressBar x:Name="ToolsProgress" Style="{StaticResource ModernProgressBarStyle}" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,15,0,0">
                            <Button x:Name="BtnToolsOpenFolder" Content="📂 Ouvrir le dossier Tools" Click="BtnToolsOpenFolder_Click" Style="{StaticResource OutlineButtonStyle}" Height="34" Padding="14,0" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnToolsCheck" Content="🔄 Vérifier les mises à jour" Click="BtnToolsCheck_Click" Style="{StaticResource OutlineButtonStyle}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                <Button x:Name="BtnToolsClose" Content="Fermer" Click="BtnToolsClose_Click" Style="{StaticResource OutlineButtonStyle}" Width="110" Height="34"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="DocumentViewerOverlay" Visibility="Collapsed" Background="#D8000000" Grid.RowSpan="3" Panel.ZIndex="999">
                <!-- Netteté du texte : la lueur (DropShadowEffect de CardGlowStyle) est portée par un cadre vide
                     placé DERRIÈRE le contenu, et non par le conteneur du texte. Un effet sur un parent fait
                     rendre tout son contenu en image (sans ClearType), ce qui rendait le texte flou. -->
                <Grid Width="700" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True">
                <Border Background="{DynamicResource BgCard}" CornerRadius="10" Style="{StaticResource CardGlowStyle}"/>
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtDocumentViewerTitle" Grid.Row="0" Text="Document" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Border Grid.Row="1" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                                <TextBlock x:Name="TxtDocumentViewerContent" Text="" Foreground="{DynamicResource TextSecondary}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                           TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                            </ScrollViewer>
                        </Border>

                        <StackPanel x:Name="DocumentViewerAcceptButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnDocumentViewerDecline" Content="Refuser" Click="BtnDocumentViewerDecline_Click" Style="{StaticResource OutlineButtonStyle}" Width="110" Height="34" Margin="0,0,10,0"/>
                            <Button x:Name="BtnDocumentViewerAccept" Content="✔️ J'accepte" Click="BtnDocumentViewerAccept_Click" Style="{StaticResource PrimaryButtonStyle}" Width="150" Height="34"/>
                        </StackPanel>

                        <StackPanel x:Name="DocumentViewerCloseButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                            <Button x:Name="BtnDocumentViewerClose" Content="Fermer" Click="BtnDocumentViewerClose_Click" Style="{StaticResource OutlineButtonStyle}" Width="110" Height="34"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
            </Grid>

        </Grid>
    </Border>
    </Grid>
</Window>
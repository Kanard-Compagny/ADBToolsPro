                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Diagnostic, contrôle et dépannage de terminaux Android de toutes marques, sans ligne de commande. Tout se passe sur ce PC : aucune donnée n'est envoyée sur Internet (seuls les outils tiers sont téléchargés depuis leurs sites officiels)."
                                                       FontSize="13" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <TextBlock Text="Composants tiers : ADB et Fastboot (Google), scrcpy (Apache 2.0), FFmpeg (GPL v3), DocumentFormat.OpenXml et LiveCharts (MIT)."
                                                       FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <TextBlock Text="Logiciel libre et gratuit sous licence GNU GPL v3 : chacun peut l'utiliser, le partager et l'améliorer, à condition que ses versions restent libres. Fourni sans aucune garantie."
                                                       FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                            <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,10" HorizontalAlignment="Left" Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/Resources/mr_kanard.png" Width="36" Height="36" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Conçu et développé par" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                                        <TextBlock Text="Mr.Kanard" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>

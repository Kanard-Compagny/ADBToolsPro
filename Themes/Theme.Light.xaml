<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème clair — palette reprise de Scanalyse (direction C « Atelier »).
         Règles : vert (Brand/Accent) = identité, sélection, focus ;
         orange (Action) = action principale uniquement, une fois par écran ;
         Warn = jaune (jamais l'orange de marque). Les deux thèmes ont exactement les mêmes clés. -->

    <!-- Couleurs brutes (utiles pour les effets : DropShadowEffect, animations) -->
    <Color x:Key="C.Bg">#F4F5F6</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.Surface2">#EDEFF1</Color>
    <Color x:Key="C.Line">#E1E4E7</Color>
    <Color x:Key="C.Ink">#15191C</Color>
    <Color x:Key="C.Muted">#5D656C</Color>
    <Color x:Key="C.Brand">#145C43</Color>
    <Color x:Key="C.BrandText">#145C43</Color>
    <Color x:Key="C.BrandSoft">#E1EEE8</Color>
    <Color x:Key="C.OnBrand">#FFFFFF</Color>
    <Color x:Key="C.Accent">#145C43</Color>
    <Color x:Key="C.OnAccent">#FFFFFF</Color>
    <Color x:Key="C.Focus">#145C43</Color>
    <Color x:Key="C.Action">#F07F13</Color>
    <Color x:Key="C.ActionHover">#E0700A</Color>
    <Color x:Key="C.OnAction">#1B0F02</Color>
    <Color x:Key="C.TitleBg">#0B3125</Color>
    <Color x:Key="C.TitleInk">#E6F0EB</Color>
    <Color x:Key="C.TitleMuted">#9DBFB1</Color>
    <Color x:Key="C.TitleHover">#174A38</Color>
    <Color x:Key="C.ToolbarBg">#FFFFFF</Color>
    <Color x:Key="C.SideBg">#0F3D2E</Color>
    <Color x:Key="C.SideInk">#E6F0EB</Color>
    <Color x:Key="C.SideMuted">#A9C3B7</Color>
    <Color x:Key="C.SideHoverBg">#164C39</Color>
    <Color x:Key="C.SideActiveBg">#1D6248</Color>
    <Color x:Key="C.SideActiveInk">#FFFFFF</Color>
    <Color x:Key="C.OkBg">#E1F2E8</Color>
    <Color x:Key="C.OkFg">#13633F</Color>
    <Color x:Key="C.InfoBg">#E4ECF7</Color>
    <Color x:Key="C.InfoFg">#244F86</Color>
    <Color x:Key="C.WarnBg">#FBF0C8</Color>
    <Color x:Key="C.WarnFg">#6B5000</Color>
    <Color x:Key="C.BadBg">#FCE5E3</Color>
    <Color x:Key="C.BadFg">#A3261C</Color>
    <Color x:Key="C.ConsoleBg">#FFFFFF</Color>
    <Color x:Key="C.ConsoleInk">#2A3035</Color>
    <Color x:Key="C.ConsoleMuted">#6B747B</Color>
    <Color x:Key="C.Check">#E6E8EA</Color>
    <Color x:Key="C.ScrollThumb">#C3C8CD</Color>

    <!-- Pinceaux de la charte -->
    <SolidColorBrush x:Key="Bg" Color="#F4F5F6"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#EDEFF1"/>
    <SolidColorBrush x:Key="Line" Color="#E1E4E7"/>
    <SolidColorBrush x:Key="Ink" Color="#15191C"/>
    <SolidColorBrush x:Key="Muted" Color="#5D656C"/>
    <SolidColorBrush x:Key="Brand" Color="#145C43"/>
    <SolidColorBrush x:Key="BrandText" Color="#145C43"/>
    <SolidColorBrush x:Key="BrandSoft" Color="#E1EEE8"/>
    <SolidColorBrush x:Key="OnBrand" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#145C43"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Focus" Color="#145C43"/>
    <SolidColorBrush x:Key="Action" Color="#F07F13"/>
    <SolidColorBrush x:Key="ActionHover" Color="#E0700A"/>
    <SolidColorBrush x:Key="OnAction" Color="#1B0F02"/>
    <SolidColorBrush x:Key="TitleBg" Color="#0B3125"/>
    <SolidColorBrush x:Key="TitleInk" Color="#E6F0EB"/>
    <SolidColorBrush x:Key="TitleMuted" Color="#9DBFB1"/>
    <SolidColorBrush x:Key="TitleHover" Color="#174A38"/>
    <SolidColorBrush x:Key="ToolbarBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SideBg" Color="#0F3D2E"/>
    <SolidColorBrush x:Key="SideInk" Color="#E6F0EB"/>
    <SolidColorBrush x:Key="SideMuted" Color="#A9C3B7"/>
    <SolidColorBrush x:Key="SideHoverBg" Color="#164C39"/>
    <SolidColorBrush x:Key="SideActiveBg" Color="#1D6248"/>
    <SolidColorBrush x:Key="SideActiveInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OkBg" Color="#E1F2E8"/>
    <SolidColorBrush x:Key="OkFg" Color="#13633F"/>
    <SolidColorBrush x:Key="InfoBg" Color="#E4ECF7"/>
    <SolidColorBrush x:Key="InfoFg" Color="#244F86"/>
    <SolidColorBrush x:Key="WarnBg" Color="#FBF0C8"/>
    <SolidColorBrush x:Key="WarnFg" Color="#6B5000"/>
    <SolidColorBrush x:Key="BadBg" Color="#FCE5E3"/>
    <SolidColorBrush x:Key="BadFg" Color="#A3261C"/>
    <SolidColorBrush x:Key="ConsoleBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ConsoleInk" Color="#2A3035"/>
    <SolidColorBrush x:Key="ConsoleMuted" Color="#6B747B"/>
    <SolidColorBrush x:Key="Check" Color="#E6E8EA"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#C3C8CD"/>

    <!-- Anciennes clés conservées pour compatibilité avec le XAML et le code existants -->
    <SolidColorBrush x:Key="BgPrimary" Color="#F4F5F6"/>
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E1E4E7"/>
    <SolidColorBrush x:Key="AccentColor" Color="#145C43"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5D656C"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#15191C"/>
    <SolidColorBrush x:Key="DangerColor" Color="#A3261C"/>
    <SolidColorBrush x:Key="StatusSuccess" Color="#13633F"/>
    <SolidColorBrush x:Key="StatusWarning" Color="#6B5000"/>
    <SolidColorBrush x:Key="StatusInfo" Color="#244F86"/>
    <Color x:Key="AccentOrangeColor">#F07F13</Color>
    <Color x:Key="DangerRedColor">#A3261C</Color>

    <!-- Polices -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<!-- Mini appli « ADB Tools Helper », installée par le Master d'ADB Tools pour ce qu'ADB seul ne peut plus faire :
     - enregistrer un réseau Wi-Fi (depuis Android 11, « cmd wifi connect-network » est réservé aux terminaux rootés ;
       une appli visant Android 9, targetSdkVersion 28, peut encore le faire) ;
     - changer la langue du système (autorisation CHANGE_CONFIGURATION, accordée par ADB avec « pm grant »).
     Pas d'icône, pas d'écran : deux récepteurs réservés à ADB (autorisation DUMP, que seuls le shell ADB et le
     système possèdent). Elle reste installée : Android retire les réseaux d'une appli quand on la désinstalle.
     Aucune donnée n'est envoyée ailleurs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.kanard.adbtools.helper"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />

    <application android:label="ADB Tools Helper" android:allowBackup="false">
        <receiver android:name=".AddNetwork" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name=".SetLocale" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
